# Tangology Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Base64-encoded Firebase config JSON
# Copy from TangoTiempo.com/.env.local - same Firebase project (tangotiempo-257ff)
# User accounts are shared across all Tango Universe apps
NEXT_PUBLIC_FIREBASE_JSON=

# Application ID for cross-app tracking
# 1=TangoTiempo, 2=HarmonyJunction, 3=NTTT, 4=TangoDJ, 5=Tangology
NEXT_PUBLIC_APPLICATION_ID=5

# =============================================================================
# VERCEL ENVIRONMENT
# =============================================================================
# Automatically set by Vercel (do not set manually)
# VERCEL_ENV=production|preview|development
#
# Used to determine collection prefix:
# - production: users, tlo_paper_views, etc.
# - preview/dev: test_users, test_tlo_paper_views, etc.

# =============================================================================
# OPTIONAL
# =============================================================================
# Base URL for paper loading (defaults to localhost:4001 in dev)
# NEXT_PUBLIC_BASE_URL=https://tangology.org
